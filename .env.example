# Ollama server manzili (boshqa kompyuterda bo'lsa, o'sha manzilni yozing)
OLLAMA_BASE_URL=http://localhost:11434

# Asosiy model va undan yaratiladigan LocalAI modeli nomi
LOCALAI_BASE_MODEL=qwen3.5:9b
LOCALAI_MODEL=localai

# Kontekst oynasi (token). Xotira kam bo'lsa 8192 qiling, ko'p bo'lsa 32768.
LOCALAI_NUM_CTX=16384

# Nisbiy yo'llar shu papkadan boshlanadi (standart: uy papkasi)
# LOCALAI_WORKSPACE=~/Projects

# Veb interfeys porti va yuklash limiti (MB)
PORT=8501
LOCALAI_MAX_UPLOAD_MB=25

# Boshqa nom yoki IP orqali ochish kerak bo'lsa (vergul bilan). Ehtiyot bo'ling!
# LOCALAI_ALLOWED_HOSTS=192.168.1.10
